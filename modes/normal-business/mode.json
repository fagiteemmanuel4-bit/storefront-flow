    "preview": {
      "fixtureSet": "normal-demo-v1",
      "allowLiveCustomerData": false,
      "allowPublishedWrites": false,
      "viewportPresets": [
        "mobile-390",
        "tablet-768",
        "desktop-1440"
      ],
      "defaultViewport": "desktop"
    }
  },
  "checkout": {
    "fields": [
