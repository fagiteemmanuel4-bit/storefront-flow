    "productDiscovery": {
      "searchableFields": [
        "name",
        "description",
        "category",
        "brand"
      ],
      "filters": [
        {
          "id": "category",
          "label": "Category",
          "source": "product.category",
          "type": "multi-select"
        },
        {
          "id": "availability",
          "label": "Availability",
          "source": "inventory.available_quantity",
          "type": "enum",
          "values": [
            "in-stock",
            "out-of-stock"
          ]
        },
        {
          "id": "price",
          "label": "Price range",
          "source": "product.price",
          "type": "range"
        }
      ],
      "sortOptions": [
        {
          "id": "name-asc",
          "label": "Name: A to Z",
          "field": "name",
          "direction": "asc"
        },
        {
          "id": "price-asc",
          "label": "Price: low to high",
          "field": "price",
          "direction": "asc"
        },
        {
          "id": "price-desc",
          "label": "Price: high to low",
          "field": "price",
          "direction": "desc"
        }
      ],
      "defaultSort": "name-asc"
    },
    "productPage": {
      "layout": "gallery-details",
      "gallery": {
        "enabled": true,
        "source": "product_images",
        "maxImages": 6
      },
      "showPrice": true,
      "showAvailability": true,
      "showCategory": true,
      "showSku": false,
      "showRelatedProducts": true,
      "variantSelector": false
    },
    "pages": [
      "home",
      "collection",
      "product",
      "cart",
      "content"
