{
  "$schema": "../../schemas/business-mode-profile.schema.json",
  "schemaVersion": 1,
  "profileVersion": 1,
  "id": "normal-business",
  "name": "Normal Business",
  "status": "draft",
  "runtimeReady": false,
  "baseCatalog": "normal",
  "businessModeKeys": [
    "general-retail"
  ],
  "description": "The Normal Business baseline profile for general retail and mixed everyday product shops. It is the first data-driven mode profile for Strap Online Store.",
  "principles": [
    "All mode-specific product fields, variants, order statuses, checkout fields, dashboard cards, storefront sections, filters and templates are read from this profile.",
    "Shared UI and services must not branch on a business-mode name when profile data can express the behavior.",
    "The Physical Store and Online Store remain separate workspaces. They share store-scoped product, inventory, customer and order services through explicit contracts.",
    "Templates and section JSON are declarative configuration only. Render only registered components; never execute arbitrary code from JSON.",
    "Missing, invalid or unsupported profile configuration fails closed and never silently falls back to another mode."
  ],
  "product": {
    "entity": "products",
    "inventoryEntity": "branch_stock",
    "fields": [
      {
        "id": "name",
        "label": "Product name",
        "column": "name",
        "type": "text",
        "required": true,
        "maxLength": 120,
        "surfaces": [
          "physical",
          "online"
        ],
        "searchable": true
      },
      {
        "id": "description",
        "label": "Description",
        "column": "description",
        "type": "long-text",
        "required": false,
        "surfaces": [
          "online"
        ],
        "searchable": true
      },
      {
        "id": "sku",
        "label": "SKU",
        "column": "sku",
        "type": "text",
        "required": false,
        "maxLength": 60,
        "surfaces": [
          "physical",
          "online"
        ],
        "searchable": true
      },
      {
        "id": "barcode",
        "label": "Barcode",
        "column": "barcode",
        "type": "text",
        "required": false,
        "maxLength": 60,
        "surfaces": [
          "physical"
        ],
        "searchable": false
      },
      {
        "id": "category",
        "label": "Category",
        "column": "category",
        "type": "text",
        "required": false,
        "maxLength": 60,
        "surfaces": [
          "physical",
          "online"
        ],
        "searchable": true,
        "filterable": true
      },
      {
        "id": "brand",
        "label": "Brand",
        "column": "brand",
        "type": "text",
        "required": false,
        "surfaces": [
          "physical",
          "online"
        ],
        "searchable": true
      },
      {
        "id": "manufacturer",
        "label": "Manufacturer",
        "column": "manufacturer",
        "type": "text",
        "required": false,
        "surfaces": [
          "physical"
        ],
        "searchable": true
      },
      {
        "id": "unit",
        "label": "Selling unit",
        "column": "unit",
        "type": "text",
        "required": false,
        "surfaces": [
          "physical",
          "online"
        ]
      },
      {
        "id": "price",
        "label": "Selling price",
        "column": "price",
        "type": "money",
        "required": true,
        "min": 0,
        "surfaces": [
          "physical",
          "online"
        ],
        "sortable": true
      },
      {
        "id": "cost",
        "label": "Unit cost",
        "column": "cost",
        "type": "money",
        "required": false,
        "min": 0,
        "surfaces": [
          "physical"
        ]
      },
      {
        "id": "lowStockThreshold",
        "label": "Low-stock threshold",
        "column": "low_stock_threshold",
        "type": "integer",
        "required": false,
        "min": 0,
        "surfaces": [
          "physical"
        ]
      },
      {
        "id": "quantity",
        "label": "Available quantity",
        "source": "branch_stock.quantity",
        "type": "integer",
        "required": false,
        "readOnly": true,
        "surfaces": [
          "physical",
          "online"
        ],
        "notes": "Aggregated or branch-scoped from the inventory ledger; never written directly by storefront JSON."
      },
      {
        "id": "images",
        "label": "Product images",
        "source": "product_images",
        "type": "image-list",
        "required": false,
        "maxItems": 6,
        "surfaces": [
          "physical",
          "online"
        ]
      }
    ],
    "variants": {
      "enabled": false,
      "strategy": "simple-product",
      "optionGroups": [],
      "notes": "Normal Business baseline has no configured variant dimension. Do not show fashion size/color, electronics storage/IMEI, or food portion modifiers in this profile. A future profile revision may add generic variants after its inventory and checkout allocation contract is implemented."
    },
    "inventory": {
      "sourceOfTruth": "branch_stock",
      "quantityMutation": "inventory-ledger-or-authorized-stock-service",
      "supportsMultipleBranches": true,
      "supportsAtomicReservation": true,
      "onlineAndPhysicalShareStock": true,
      "oversellPolicy": "deny",
      "lowStockField": "low_stock_threshold"
    }
  },
  "orders": {
    "entity": "online_orders",
    "statuses": [
      {
        "id": "pending",
        "label": "Pending",
        "kind": "open",
        "customerVisible": true,
        "initial": true
      },
      {
        "id": "confirmed",
        "label": "Confirmed",
        "kind": "open",
        "customerVisible": true
      },
      {
        "id": "processing",
        "label": "Processing",
        "kind": "fulfillment",
        "customerVisible": true
      },
      {
        "id": "ready",
        "label": "Ready",
        "kind": "fulfillment",
        "customerVisible": true,
        "legacy": true
      },
      {
        "id": "shipped",
        "label": "Shipped / dispatched",
        "kind": "fulfillment",
        "customerVisible": true
      },
      {
        "id": "completed",
        "label": "Completed",
        "kind": "terminal",
        "customerVisible": true
      },
      {
        "id": "cancelled",
        "label": "Cancelled",
        "kind": "terminal",
        "customerVisible": true
      },
      {
        "id": "refunded",
        "label": "Refunded",
        "kind": "terminal",
        "customerVisible": true
      }
    ],
    "transitions": [
      {
        "from": "pending",
        "to": [
          "confirmed",
          "cancelled"
        ]
      },
      {
        "from": "confirmed",
        "to": [
          "processing",
          "shipped",
          "cancelled"
        ]
      },
      {
        "from": "processing",
        "to": [
          "shipped",
          "cancelled"
        ]
      },
      {
        "from": "ready",
        "to": [
          "completed",
          "cancelled"
        ],
        "legacyPath": true
      },
      {
        "from": "shipped",
        "to": [
          "completed"
        ]
      },
      {
        "from": "completed",
        "to": []
      },
      {
        "from": "cancelled",
        "to": []
      },
      {
        "from": "refunded",
        "to": []
      }
    ],
    "terminalStatuses": [
      "completed",
      "cancelled",
      "refunded"
    ],
    "notes": "This mirrors the current database transition guard. Do not add transitions until the server-side guard and order UI are updated and tested together."
  },
  "dashboard": {
    "cards": [
      {
        "id": "sales-today",
        "label": "Sales today",
        "source": "sales",
        "metric": "count",
        "scope": "active-branch-or-all-branches",
        "priority": 1
      },
      {
        "id": "revenue-today",
        "label": "Revenue today",
        "source": "sales.total",
        "metric": "sum",
        "scope": "active-branch-or-all-branches",
        "priority": 2
      },
      {
        "id": "low-stock",
        "label": "Low stock",
        "source": "branch_stock+products.low_stock_threshold",
        "metric": "count",
        "scope": "active-branch",
        "priority": 3
      },
      {
        "id": "orders-to-action",
        "label": "Orders to action",
        "source": "online_orders.status",
        "metric": "count",
        "filter": {
          "statuses": [
            "pending"
          ]
        },
        "scope": "store",
        "priority": 4
      }
    ],
    "notes": "Dashboard card definitions are profile-driven. Hide cards whose data source or feature flag is unavailable; never show fabricated zeroes when a query failed."
  },
  "storefront": {
    "allowedSectionTypes": [
      "announcement",
      "hero",
      "featured-products",
      "product-grid",
      "categories",
      "promotional-banner",
      "gallery",
      "about",
      "testimonials",
      "social-proof",
      "newsletter",
      "faq",
      "contact",
      "footer"
    ],
    "sectionRegistry": [
      {
        "id": "announcement",
        "label": "Announcement bar",
        "category": "marketing",
        "singleton": true,
        "settings": {
          "text": "string",
          "href": "url?",
          "tone": "enum:neutral|accent|dark"
