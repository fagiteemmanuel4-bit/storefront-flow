        "settings": {
          "title": "string",
          "collectionId": "collection?",
          "columns": "integer:2..5",
          "limit": "integer:4..48"
        }
      },
      {
        "id": "categories",
        "label": "Categories",
        "category": "catalog",
        "singleton": false,
        "settings": {
          "title": "string",
          "layout": "enum:tiles|pills|editorial",
          "limit": "integer:2..12"
        }
      },
      {
        "id": "promotional-banner",
        "label": "Promotional banner",
        "category": "marketing",
        "singleton": false,
        "settings": {
          "headline": "string",
          "body": "string?",
          "imageAsset": "asset?",
          "href": "url?"
        }
      },
      {
        "id": "gallery",
        "label": "Image gallery",
        "category": "content",
        "singleton": false,
        "settings": {
          "title": "string",
          "images": "asset[]",
          "layout": "enum:grid|masonry|carousel"
        }
      },
      {
        "id": "about",
        "label": "About",
        "category": "content",
        "singleton": false,
        "settings": {
          "title": "string",
          "body": "richText",
          "imageAsset": "asset?"
        }
      },
      {
        "id": "testimonials",
        "label": "Testimonials",
        "category": "trust",
        "singleton": false,
        "settings": {
          "title": "string",
          "source": "verified_reviews|merchant_quotes"
        }
      },
      {
        "id": "social-proof",
        "label": "Social proof",
        "category": "trust",
        "singleton": false,
        "settings": {
          "title": "string",
          "showReviewSummary": "boolean"
        }
      },
      {
        "id": "newsletter",
        "label": "Newsletter",
        "category": "marketing",
        "singleton": true,
        "settings": {
          "title": "string",
          "description": "string?",
          "consentText": "string"
        }
      },
      {
        "id": "faq",
        "label": "FAQ",
        "category": "support",
        "singleton": false,
        "settings": {
          "title": "string",
          "items": "faq[]"
        }
      },
      {
        "id": "contact",
        "label": "Contact",
        "category": "support",
        "singleton": false,
        "settings": {
          "title": "string",
          "showPhone": "boolean",
          "showEmail": "boolean",
          "showAddress": "boolean"
        }
      },
      {
        "id": "footer",
        "label": "Footer",
        "category": "navigation",
        "singleton": true,
        "settings": {
          "brandText": "string?",
          "showPolicies": "boolean",
          "showSocialLinks": "boolean"
        }
      }
    ],
