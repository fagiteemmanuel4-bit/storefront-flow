    "productDiscovery": {
      "searchableFields": [
        "name",
        "description",
        "category",
        "brand",
        "genericName",
        "strength",
        "dosageForm",
        "batchNumber"
      ],
      "filters": [
        {
          "id": "category",
          "label": "Category",
          "source": "product.category",
          "type": "multi-select"
        },
        {
          "id": "availability",
          "label": "Availability",
          "source": "inventory.available_quantity",
          "type": "enum",
          "values": [
            "in-stock",
            "out-of-stock"
          ]
        },
        {
          "id": "price",
          "label": "Price range",
          "source": "product.price",
          "type": "range"
        }
      ],
      "sortOptions": [
        {
          "id": "name-asc",
          "label": "Name: A to Z",
          "field": "name",
          "direction": "asc"
        },
        {
          "id": "price-asc",
          "label": "Price: low to high",
          "field": "price",
          "direction": "asc"
        },
        {
          "id": "price-desc",
          "label": "Price: high to low",
          "field": "price",
          "direction": "desc"
        }
      ],
      "defaultSort": "name-asc"
    },
    "productPage": {
      "layout": "gallery-details",
      "gallery": {
        "enabled": true,
        "source": "product_images",
        "maxImages": 6
      },
      "showPrice": true,
      "showAvailability": true,
      "showCategory": true,
      "showSku": false,
      "showRelatedProducts": true,
      "variantSelector": false
    },
    "pages": [
      "home",
      "collection",
      "product",
      "cart",
      "content"
    ],
    "preview": {
      "fixtureSet": "pharmacy-demo-v1",
      "allowLiveCustomerData": false,
      "allowPublishedWrites": false,
      "viewportPresets": [
        "mobile-390",
        "tablet-768",
        "desktop-1440"
      ],
      "defaultViewport": "desktop"
    }
  },
  "checkout": {
    "fields": [
      {
        "id": "customerName",
        "label": "Full name",
        "source": "online_orders.customer_name",
        "type": "text",
        "required": true
      },
      {
        "id": "customerPhone",
        "label": "Phone number",
        "source": "online_orders.customer_phone",
        "type": "tel",
        "required": true
      },
      {
        "id": "customerEmail",
        "label": "Email address",
        "source": "online_orders.customer_email",
        "type": "email",
        "required": false
      },
      {
        "id": "shippingAddress",
        "label": "Delivery address",
        "source": "online_orders.shipping_address",
        "type": "textarea",
        "required": true
      },
      {
        "id": "customerNote",
        "label": "Order note",
        "source": "online_orders.customer_note",
        "type": "textarea",
        "required": false
      }
    ],
    "fulfillmentModes": [
      {
        "id": "delivery",
        "label": "Delivery",
        "enabled": true
      }
    ],
    "paymentMethods": [
      {
        "id": "pay_on_delivery",
        "label": "Pay on delivery",
        "enabled": true,
        "implementation": "current-public-order-rpc"
      },
      {
        "id": "bank_transfer",
        "label": "Bank transfer",
        "enabled": true,
        "implementation": "current-public-order-rpc"
      }
    ],
    "paymentProviderPolicy": "Provider availability is resolved from seller country and server-side provider configuration. Do not expose card or wallet methods unless a verified provider integration is enabled.",
    "taxAndShipping": {
      "requiredBeforeCheckoutRelease": true,
      "configurationSource": "store-shipping-settings",
